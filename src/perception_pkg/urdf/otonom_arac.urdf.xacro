<?xml version="1.0"?>
<robot name="otonom_arac">
  <material name="mavi"><color rgba="0.1 0.3 0.8 1"/></material>
  <material name="siyah"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="gri"><color rgba="0.5 0.5 0.5 1"/></material>

  <link name="base_link">
    <visual><geometry><box size="0.5 0.3 0.15"/></geometry><material name="mavi"/></visual>
    <collision><geometry><box size="0.5 0.3 0.15"/></geometry></collision>
    <inertial><mass value="5.0"/>
      <inertia ixx="0.05" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <link name="tekerlek_sol_arka">
    <visual><geometry><cylinder radius="0.07" length="0.04"/></geometry><material name="siyah"/></visual>
    <collision><geometry><cylinder radius="0.07" length="0.04"/></geometry></collision>
    <inertial><mass value="0.3"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="tekerlek_sol_arka_joint" type="continuous">
    <parent link="base_link"/><child link="tekerlek_sol_arka"/>
    <origin xyz="-0.15 0.17 -0.07" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/>
  </joint>

  <link name="tekerlek_sag_arka">
    <visual><geometry><cylinder radius="0.07" length="0.04"/></geometry><material name="siyah"/></visual>
    <collision><geometry><cylinder radius="0.07" length="0.04"/></geometry></collision>
    <inertial><mass value="0.3"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="tekerlek_sag_arka_joint" type="continuous">
    <parent link="base_link"/><child link="tekerlek_sag_arka"/>
    <origin xyz="-0.15 -0.17 -0.07" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/>
  </joint>

  <link name="tekerlek_sol_on">
    <visual><geometry><cylinder radius="0.07" length="0.04"/></geometry><material name="siyah"/></visual>
    <collision><geometry><cylinder radius="0.07" length="0.04"/></geometry></collision>
    <inertial><mass value="0.3"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="tekerlek_sol_on_joint" type="continuous">
    <parent link="base_link"/><child link="tekerlek_sol_on"/>
    <origin xyz="0.15 0.17 -0.07" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/>
  </joint>

  <link name="tekerlek_sag_on">
    <visual><geometry><cylinder radius="0.07" length="0.04"/></geometry><material name="siyah"/></visual>
    <collision><geometry><cylinder radius="0.07" length="0.04"/></geometry></collision>
    <inertial><mass value="0.3"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="tekerlek_sag_on_joint" type="continuous">
    <parent link="base_link"/><child link="tekerlek_sag_on"/>
    <origin xyz="0.15 -0.17 -0.07" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/>
  </joint>

  <link name="kamera_link">
    <visual><geometry><box size="0.05 0.05 0.05"/></geometry><material name="gri"/></visual>
    <inertial><mass value="0.1"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="kamera_joint" type="fixed">
    <parent link="base_link"/><child link="kamera_link"/>
    <origin xyz="0.25 0 0.12" rpy="0 0.2 0"/>
  </joint>

  <gazebo reference="kamera_link">
    <sensor name="arac_kamerasi" type="camera">
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>50.0</far></clip>
      </camera>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <plugin name="arac_kamera_driver" filename="libgazebo_ros_camera.so">
        <ros><namespace>arac</namespace></ros>
        <camera_name>kamera</camera_name>
        <frame_name>kamera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>arac</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <left_joint>tekerlek_sol_arka_joint</left_joint>
      <right_joint>tekerlek_sag_arka_joint</right_joint>
      <wheel_separation>0.34</wheel_separation>
      <wheel_diameter>0.14</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>
</robot>
